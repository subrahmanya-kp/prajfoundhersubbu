# --- Shared ---
DJANGO_SECRET_KEY=change-me-to-a-random-secret
DEBUG=True
ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Each service uses its own SQLite database file (set directly in docker-compose.yml
# as DATABASE_URL=sqlite:////data/db.sqlite3, persisted via a named volume). For local
# non-docker development, omit DATABASE_URL and each service will default to a
# db.sqlite3 file inside its own directory.

# STORAGE_BACKEND controls which backend media-service uploads to: "s3" or "gdrive"
STORAGE_BACKEND=s3
MAX_UPLOAD_SIZE_BYTES=15728640

# S3 backend (used when STORAGE_BACKEND=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1
AWS_S3_KEY_PREFIX=wedding-photos/

# Google Drive backend (used when STORAGE_BACKEND=gdrive)
# GOOGLE_SERVICE_ACCOUNT_JSON must be the full service account JSON key, as a single-line string.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_FOLDER_ID=
